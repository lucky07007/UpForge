/*
IMPORTANT:
With @opennextjs/cloudflare, do NOT use:
  export const runtime = "edge";

Remove that export from the quiz route handlers.
OpenNext Cloudflare uses the Next.js Node.js runtime and the Cloudflare
Workers Node.js compatibility layer.
*/
