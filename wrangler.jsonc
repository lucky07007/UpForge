{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "upforge",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "upforge-cache"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "UPFORGE_KV",
      "id": "upforge-kv"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "upforge"
    }
  ],
  "routes": [
    { "pattern": "upforge.org", "custom_domain": true },
    { "pattern": "www.upforge.org", "custom_domain": true }
  ]
}
